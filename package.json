{
  "name": "cointrack-fe",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev": "pnpm --filter @cointrack/web dev",
    "build": "pnpm --filter @cointrack/web build",
    "start": "pnpm --filter @cointrack/web start",
    "lint": "pnpm --filter @cointrack/web lint",
    "typecheck": "pnpm -r typecheck",
    "mobile": "pnpm --filter @cointrack/mobile start",
    "test": "pnpm --filter @cointrack/utils test"
  }
}
