{
  "expo": {
    "name": "CoinTrack",
    "slug": "cointrack-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cointrack.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.cointrack.mobile"
    },
    "scheme": "cointrack",
    "plugins": ["expo-router", "expo-secure-store"]
  }
}
